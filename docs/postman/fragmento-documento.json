{"name":"6 · Documentos (Issue 6 — RF09/RF15/RN03/RN11)","description":"Sequência nos DOCUMENTOS do Edital B (submissaoBId, ainda RASCUNHO):\n1) upload HISTORICO_ESCOLAR (escolha um PDF local) → 201, anote → 'documentoId'\n2) upload COMPROVANTE_MATRICULA → 201 (satisfaz RN12 do Edital B)\n3) upload não-PDF → 400 · 4) OUTRO sem descrição → 400 (RN11)\n5) metadados RF15 · 6) download (bytes iguais)\n7) PATCH /status VALIDO/INCOMPLETO p/ provas RF15.\nDepois de enviar a submissão B (agora RN12 libera) o gerenciador pode pedir pendência — retorne à pasta 5 (D6/D7: PENDENTE_DOCUMENTOS → EM_ANALISE → APROVADA).","item":[{"name":"D1 · POST /{submissaoBId}/documentos (multipart, HISTORICO) → 201","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/api/submissoes/{{submissaoBId}}/documentos"},"body":{"mode":"formdata","formdata":[{"type":"text","key":"tipoDocumento","value":"HISTORICO_ESCOLAR"},{"type":"file","key":"arquivo","src":"historico.pdf"}]}}},{"name":"D2 · POST documento não-PDF → 400 ARQUIVO_INVALIDO","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/api/submissoes/{{submissaoBId}}/documentos"},"body":{"mode":"formdata","formdata":[{"type":"text","key":"tipoDocumento","value":"COMPROVANTE_MATRICULA"},{"type":"file","key":"arquivo","src":"notas.txt"}]}}},{"name":"D3 · POST tipo OUTRO sem descricaoPersonalizada → 400 (RN11)","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/api/submissoes/{{submissaoBId}}/documentos"},"body":{"mode":"formdata","formdata":[{"type":"text","key":"tipoDocumento","value":"OUTRO"},{"type":"file","key":"arquivo","src":"outro.pdf"}]}}},{"name":"D4 · POST COMPROVANTE_MATRICULA (PDF) → 201 (RN12 satisfeito)","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/api/submissoes/{{submissaoBId}}/documentos"},"body":{"mode":"formdata","formdata":[{"type":"text","key":"tipoDocumento","value":"COMPROVANTE_MATRICULA"},{"type":"file","key":"arquivo","src":"comprovante.pdf"}]}}},{"name":"D5 · GET /{submissaoBId}/documentos → 200 metadados (RF15)","request":{"method":"GET","header":[{"key":"X-Usuario-Id","value":"{{usuarioAlunoId}}"}],"url":{"raw":"{{baseUrl}}/api/submissoes/{{submissaoBId}}/documentos"},"body":{"mode":"raw","raw":""}}},{"name":"D6 · GET /api/documentos/{documentoId}/download → 200 PDF","request":{"method":"GET","header":[{"key":"X-Usuario-Id","value":"{{usuarioAlunoId}}"}],"url":{"raw":"{{baseUrl}}/api/documentos/{{documentoId}}/download"},"body":{"mode":"raw","raw":""}}},{"name":"D7 · PATCH /{documentoId}/status INCOMPLETO sem observação → 400","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Usuario-Id","value":"{{gerenciadorId}}"}],"url":{"raw":"{{baseUrl}}/api/documentos/{{documentoId}}/status"},"body":{"mode":"raw","raw":"{\"statusValidacao\":\"INCOMPLETO\"}","options":{"raw":{"language":"json"}}}}},{"name":"D8 · PATCH /{documentoId}/status VALIDO com observação → 200 (RF15)","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Usuario-Id","value":"{{gerenciadorId}}"}],"url":{"raw":"{{baseUrl}}/api/documentos/{{documentoId}}/status"},"body":{"mode":"raw","raw":"{\"statusValidacao\":\"VALIDO\",\"observacaoValidacao\":\"Histórico conferido no SIGAA\"}","options":{"raw":{"language":"json"}}}}},{"name":"D9 · PATCH /{documentoId}/status com header de ALUNO → 400 PERMISSAO_INSUFICIENTE","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Usuario-Id","value":"{{usuarioAlunoId}}"}],"url":{"raw":"{{baseUrl}}/api/documentos/{{documentoId}}/status"},"body":{"mode":"raw","raw":"{\"statusValidacao\":\"VALIDO\"}","options":{"raw":{"language":"json"}}}}},{"name":"D10 · DELETE /api/documentos/{documentoId} → 204 (RN03)","request":{"method":"DELETE","header":[{"key":"X-Usuario-Id","value":"{{usuarioAlunoId}}"}],"url":{"raw":"{{baseUrl}}/api/documentos/{{documentoId}}"},"body":{"mode":"raw","raw":""}}}]}
