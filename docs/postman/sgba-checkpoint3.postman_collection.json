\",\"dataLimite\":\"2026-12-01T00:00:00\",\"status\":\"ABERTO\"}","options":{"raw":{"language":"json"}}}}},{"name":"POST /{id}/encerrar → 200 (RF03, controle do gerenciador)","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/api/programas/{{programaNovoId}}/encerrar"},"body":{"mode":"raw","raw":""}}},{"name":"POST /{id}/encerrar de novo → 409 PROGRAMA_JA_ENCERRADO","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/api/programas/{{programaNovoId}}/encerrar"},"body":{"mode":"raw","raw":""}}},{"name":"POST /999/encerrar → 404","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/api/programas/999/encerrar"},"body":{"mode":"raw","raw":""}}}]},{"name":"4 · Editais (Issue 4 — perguntas, exigências e PDF)","description":"Seed: Edital A id=1 (08/2026, aberto, perguntas+exigências opcionais) · B id=2 (09/2026, exigências OBRIGATÓRIAS) · C id=3 (07/2025, janela encerrada) · D id=4 (10/2026, sem formulário).\nContratos: 400 janela invertida/enum · 409 duplicado nº+ano, ordem já usada, tipo já exigido · 201/204 nas rotas aninhadas.\nMultipart do PDF: campo 'file' com um PDF local.","item":[{"name":"GET lista (?programaId) → 200","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/editais?programaId={{programaId}}&page=0&size=10"},"body":{"mode":"raw","raw":""}}},{"name":"GET /{editalAId} → 200","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/editais/{{editalAId}}"},"body":{"mode":"raw","raw":""}}},{"name":"GET /{editalAId}/formulario → 200 (perguntas ordenadas + exigências)","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/editais/{{editalAId}}/formulario"},"body":{"mode":"raw","raw":""}}},{"name":"POST válido → 201 + Location","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/editais"},"body":{"mode":"raw","raw":"{\"programaId\":1,\"numeroEdital\":\"11\",\"ano\":2026,\"dataInicioSubmissoes\":\"2026-11-01T09:00:00\",\"dataFimSubmissoes\":\"2026-12-31T23:59:59\"}","options":{"raw":{"language":"json"}}}}},{"name":"POST duplicado 08/2026 → 409 EDITAL_DUPLICADO","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/editais"},"body":{"mode":"raw","raw":"{\"programaId\":1,\"numeroEdital\":\"08\",\"ano\":2026,\"dataInicioSubmissoes\":\"2026-01-01T09:00:00\",\"dataFimSubmissoes\":\"2026-02-28T23:59:59\"}","options":{"raw":{"language":"json"}}}}},{"name":"POST janela invertida → 400 JANELA_INVALIDA","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/editais"},"body":{"mode":"raw","raw":"{\"programaId\":1,\"numeroEdital\":\"12\",\"ano\":2026,\"dataInicioSubmissoes\":\"2026-06-01T09:00:00\",\"dataFimSubmissoes\":\"2026-05-01T09:00:00\"}","options":{"raw":{"language":"json"}}}}},{"name":"POST /{editalDId}/perguntas → 201 (ordem 1)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/editais/{{editalDId}}/perguntas"},"body":{"mode":"raw","raw":"{\"enunciado\":\"Descreva sua experiencia com bolsas\",\"obrigatoria\":true,\"ordemExibicao\":1}","options":{"raw":{"language":"json"}}}}},{"name":"POST /{editalDId}/perguntas ordem repetida → 409 ORDEM_JA_USADA","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/editais/{{editalDId}}/perguntas"},"body":{"mode":"raw","raw":"{\"enunciado\":\"Outra pergunta\",\"obrigatoria\":false,\"ordemExibicao\":1}","options":{"raw":{"language":"json"}}}}},{"name":"PUT /{editalDId}/perguntas/{perguntaId} → 200","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/editais/{{editalDId}}/perguntas/1"},"body":{"mode":"raw","raw":"{\"enunciado\":\"Descreva sua experiencia com bolsas (atualizada)\",\"obrigatoria\":true,\"ordemExibicao\":1}","options":{"raw":{"language":"json"}}}}},{"name":"DELETE /{editalDId}/perguntas/{perguntaId} → 204","request":{"method":"DELETE","header":[],"url":{"raw":"{{baseUrl}}/api/editais/{{editalDId}}/perguntas/1"},"body":{"mode":"raw","raw":""}}},{"name":"POST /{editalDId}/exigencias → 201 (HISTORICO opcional)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/editais/{{editalDId}}/exigencias"},"body":{"mode":"raw","raw":"{\"tipoDocumento\":\"HISTORICO_ESCOLAR\",\"obrigatorio\":false}","options":{"raw":{"language":"json"}}}}},{"name":"POST /{editalDId}/exigencias tipo repetido → 409 TIPO_JA_EXIGIDO","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/editais/{{editalDId}}/exigencias"},"body":{"mode":"raw","raw":"{\"tipoDocumento\":\"HISTORICO_ESCOLAR\",\"obrigatorio\":true}","options":{"raw":{"language":"json"}}}}},{"name":"DELETE /{editalDId}/exigencias/{exigenciaId} → 204","request":{"method":"DELETE","header":[],"url":{"raw":"{{baseUrl}}/api/editais/{{editalDId}}/exigencias/5"},"body":{"mode":"raw","raw":""}}},{"name":"POST /{editalDId}/arquivo (multipart PDF) → 201","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/api/editais/{{editalDId}}/arquivo"},"body":{"mode":"formdata","formdata":[{"type":"file","key":"file","src":"edital-padrao.pdf"}]}}},{"name":"GET /{editalDId}/arquivo → 200 application/pdf","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/editais/{{editalDId}}/arquivo"},"body":{"mode":"raw","raw":""}}}]},{"name":"5 · Submissões — ciclo de vida (Issue 5 — módulo central)","description":"DEMO EM ORDEM (banco limpo; header X-Usuario-Id = D1):\nA. aluno(1): criar rascunho Edital A → duplicada 409 → orientador inválido 400 → enviar sem resposta 409 (RN12) → PUT respostas+termo → enviar 200 (protocolo #2026-0001; anote em 'submissaoIdA').\nB. criar rascunho Edital C (janela encerrada) → enviar 409 FORA_DO_PRAZO (anote 'submissaoCId').\nC. criar rascunho Edital B (exigências obrigatórias) → enviar 409 ENVIO_INCOMPLETO (docs faltam) (anote 'submissaoBId') → pasta Documentos segue dele.\nD. gerenciador(3): PATCH EM_ANALISE → PENDENTE_DOCUMENTOS (motivo) — retornar após Documentos → EM_ANALISE → APROVADA.\nBloqueios extras: PATCH sem motivo 400 · PATCH com header aluno 400 PERMISSAO_INSUFICIENTE · PATCH RASCUNHO→APROVADA 409.","item":[{"name":"A1 · POST rascunho Edital A (header aluno) → 201 + Location","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Usuario-Id","value":"{{usuarioAlunoId}}"}],"url":{"raw":"{{baseUrl}}/api/submissoes"},"body":{"mode":"raw","raw":"{\"editalId\":{{editalAId}},\"tituloProjeto\":\"IA aplicada ao ensino de algoritmos\",\"projetoResumo\":\"Estudo de assistentes em monitoria\",\"planoTrabalho\":\"Cronograma em 6 etapas mensais\",\"orientadorId\":{{professorId}}}","options":{"raw":{"language":"json"}}}}},{"name":"A2 · POST duplicado (mesmo aluno+edital) → 409 SUBMISSAO_DUPLICADA","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Usuario-Id","value":"{{usuarioAlunoId}}"}],"url":{"raw":"{{baseUrl}}/api/submissoes"},"body":{"mode":"raw","raw":"{\"editalId\":{{editalAId}},\"tituloProjeto\":\"Rascunho duplicado\"}","options":{"raw":{"language":"json"}}}}},{"name":"A3 · POST orientador do tipo ALUNO → 400 ORIENTADOR_INVALIDO (RN10)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Usuario-Id","value":"{{usuarioAlunoId}}"}],"url":{"raw":"{{baseUrl}}/api/submissoes"},"body":{"mode":"raw","raw":"{\"editalId\":{{editalAId}},\"tituloProjeto\":\"Orientador errado\",\"orientadorId\":{{usuarioAlunoId}}}","options":{"raw":{"language":"json"}}}}},{"name":"A4 · POST /{submissaoIdA}/enviar sem resposta → 409 ENVIO_INCOMPLETO (RN12)","request":{"method":"POST","header":[{"key":"X-Usuario-Id","value":"{{usuarioAlunoId}}"}],"u